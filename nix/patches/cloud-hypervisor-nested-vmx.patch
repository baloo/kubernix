+    GetNestedModelSpecificRegistersCount { read: usize, requested: usize },
     /// Failed to set SREGs for this CPU.
     #[error("Failed to set SREGs for this CPU")]
     SetStatusRegisters(#[source] hypervisor::HypervisorCpuError),
@@ -81,9 +91,64 @@ pub fn setup_fpu(vcpu: &dyn hypervisor::Vcpu) -> Result<()> {
 /// # Arguments
 ///
 /// * `vcpu` - Structure for the VCPU that holds the VCPU's fd.
-pub fn setup_msrs(vcpu: &dyn hypervisor::Vcpu) -> Result<()> {
-    vcpu.set_msrs(vcpu.boot_msr_entries())
+pub fn setup_msrs(vcpu: &dyn hypervisor::Vcpu, cpu_vendor: CpuVendor, nested: bool) -> Result<()> {
+    let mut msrs = vcpu.boot_msr_entries().to_vec();
+
+    if nested && cpu_vendor == CpuVendor::Intel {
+        // Match QEMU's nested-VMX feature MSR selection/order: write
+        // IA32_FEATURE_CONTROL first, then only the VMX capability MSRs KVM
+        // accepts as feature MSRs.
+        const NESTED_VMX_FEATURE_MSRS: [u32; 11] = [
+            msr_index::MSR_IA32_VMX_TRUE_PROCBASED_CTLS,
+            msr_index::MSR_IA32_VMX_TRUE_PINBASED_CTLS,
+            msr_index::MSR_IA32_VMX_TRUE_EXIT_CTLS,
+            msr_index::MSR_IA32_VMX_TRUE_ENTRY_CTLS,
+            msr_index::MSR_IA32_VMX_PROCBASED_CTLS2,
+            msr_index::MSR_IA32_VMX_EPT_VPID_CAP,
+            msr_index::MSR_IA32_VMX_BASIC,
+            msr_index::MSR_IA32_VMX_MISC,
+            msr_index::MSR_IA32_VMX_VMFUNC,
+            msr_index::MSR_IA32_VMX_CR0_FIXED0,
+            msr_index::MSR_IA32_VMX_CR4_FIXED0,
+        ];
+
+        let mut vmx_feature_msrs: Vec<MsrEntry> = NESTED_VMX_FEATURE_MSRS
+            .iter()
+            .map(|index| MsrEntry {
+                index: *index,
+                ..Default::default()
+            })
+            .collect();
+
+        let read = vcpu
+            .get_msrs(&mut vmx_feature_msrs)
+            .map_err(Error::GetNestedModelSpecificRegisters)?;
+        if read != vmx_feature_msrs.len() {
+            return Err(Error::GetNestedModelSpecificRegistersCount {
+                read,
+                requested: vmx_feature_msrs.len(),
+            });
+        }
+
+        msrs.push(MsrEntry {
+            index: msr_index::MSR_IA32_FEATURE_CONTROL,
+            data: u64::from(
+                msr_index::FEATURE_CONTROL_LOCKED
+                    | msr_index::FEATURE_CONTROL_VMXON_ENABLED_OUTSIDE_SMX,
+            ),
+        });
+        msrs.extend(vmx_feature_msrs);
+    }
+
+    let written = vcpu
+        .set_msrs(&msrs)
         .map_err(Error::SetModelSpecificRegisters)?;
+    if written != msrs.len() {
+        return Err(Error::SetModelSpecificRegistersCount {
+            written,
+            requested: msrs.len(),
+        });
+    }
 
     Ok(())
 }
